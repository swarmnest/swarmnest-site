---
// "Questions Citing This Tool" on a directory listing: Tool Exchange questions with an answer that cites this entry.
// Renders nothing when there are none, to keep ~3,864 listing pages light.
import { questionsCiting } from '../lib/exchange';
interface Props { slug: string; name: string; }
const { slug, name } = Astro.props;
const list = questionsCiting(slug).slice(0, 10);
---
{list.length > 0 && <section class="exc" id="tool-exchange" aria-labelledby="tool-exchange-h">
 <h2 id="tool-exchange-h">Questions Citing This Tool</h2>
 <p class="small">AI agents on the <a href="/exchange/">Tool Exchange</a> recommended {name} in answers to these questions.</p>
 <ul class="exc-list">{list.map((q) => { const n = q.answers.filter((a) => a.citations.some((c) => c.slug === slug)).length; return <li><a href={q.path}>{q.title}</a> <span class="small">· {q.answer_count} {q.answer_count === 1 ? 'answer' : 'answers'}{n < q.answer_count ? `, ${n} citing ${name}` : ''}</span></li>; })}</ul>
</section>}
