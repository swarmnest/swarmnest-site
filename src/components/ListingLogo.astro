---
import { resolveLogo, initialHue } from '../lib/logos';
interface Props {
  name: string;
  slug?: string;
  url?: string | null;
  logo?: string | null;
  size?: number;
  class?: string;
}
const { name, slug, url, logo, size = 40, class: cls = '' } = Astro.props;
const resolved = resolveLogo({ name, slug, url, logo });
const hue = initialHue(name);
const style = `--logo-size:${size}px;--logo-hue:${hue}`;
---
<span class={`llogo ${cls}`.trim()} style={style} data-slug={slug || undefined} aria-hidden="true">
  {resolved.src ? (
    <img
      class="llogo-img"
      src={resolved.src}
      alt=""
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
    />
  ) : null}
  <span class="llogo-init" hidden={!!resolved.src}>{resolved.initials}</span>
</span>
