---
// Shared shell for /guides/* pages: breadcrumbs (Home > Guides > Page), Article + FAQPage + BreadcrumbList JSON-LD,
// FAQ section, sources, related links and mobile-friendly comparison table styles (.cmp).
import Base from '../layouts/Base.astro';
import Crumbs from './Crumbs.astro';
import Related from './Related.astro';
import { SITE } from '../lib/data';
import { guide, ALL_GUIDES } from '../lib/guides';
interface Props { path: string; title: string; description: string; faqs: [string, string][]; sources: [string, string][] }
const { path, title, description, faqs, sources } = Astro.props;
const g = guide(path);
const d = new Date(g.updated + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const ld = [
 { '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:SITE+'/'},{'@type':'ListItem',position:2,name:'Guides',item:SITE+'/guides/'},{'@type':'ListItem',position:3,name:g.short,item:SITE+path}] },
 { '@context':'https://schema.org','@type':'Article',headline:g.title,description,dateModified:g.updated,datePublished:g.updated,author:{'@type':'Organization',name:'Swarmnest'},publisher:{'@type':'Organization',name:'Swarmnest'},mainEntityOfPage:SITE+path },
 { '@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}})) },
];
const more = ALL_GUIDES.filter((x) => x.path !== path && (x.topic === g.topic || x.cats.some((c) => g.cats.includes(c)))).slice(0, 4);
---
<Base title={title} description={description} path={path} jsonld={ld} type="article">
<Crumbs items={[['Home','/'],['Guides','/guides/'],[g.short]]} />
<h1>{g.title}</h1>
<slot />
<h2 id="faq">FAQ</h2>
{faqs.map(([q,a])=><><h3>{q}</h3><p>{a}</p></>)}
<h2 id="sources">Sources (Checked {d})</h2>
<ul>{sources.map(([label, href]) => <li><a href={href} rel="noopener nofollow">{label}</a></li>)}</ul>
<p class="small">Updated {d}. Prices and limits come from each provider's site on that day and can change. Sponsorship never affects which tools appear in a guide or their order. Questions or corrections: <a href="mailto:hello@swarmnest.ai">hello@swarmnest.ai</a>.</p>
{more.length > 0 && <section aria-labelledby="more-g"><div class="grp-h"><h2 id="more-g">More Guides</h2><a class="small" href="/guides/">All Guides</a></div>
<div class="grid">{more.map((x) => <a class="card" href={x.path}><h3>{x.short}</h3><p>{x.blurb}</p></a>)}</div></section>}
<Related self={path} max={6} />
</Base>
<style is:global>
.cmp,.sm-kv{margin:.6rem 0 1.4rem}.cmp th,.sm-kv th{width:auto}.sm-kv th{white-space:nowrap}
.cmp td:first-child{min-width:8rem}
.install pre{white-space:pre-wrap;word-break:break-word}
@media (max-width:700px){
 .cmp thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
 .cmp tr{display:block;border:1px solid var(--line);border-radius:10px;padding:6px 4px;margin:0 0 12px;background:var(--card)}
 .cmp td{display:block;border:0;padding:4px 8px}
 .cmp td::before{content:attr(data-l);display:block;font-size:.8rem;color:var(--mut)}
 .cmp td:first-child::before{display:none}
 .sm-kv tr,.sm-kv th,.sm-kv td{display:block}.sm-kv th{padding-bottom:0;border-bottom:0}
}
</style>
