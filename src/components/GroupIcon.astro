---
interface Props {
  slug: string;
  size?: number;
  class?: string;
}
const { slug, size = 22, class: cls = '' } = Astro.props;
const src = `/icons/groups/${slug}.svg`;
---
<span class={`gicon ${cls}`.trim()} style={`--gicon-size:${size}px`} aria-hidden="true">
  <img src={src} alt="" width={size} height={size} loading="lazy" decoding="async" />
</span>
