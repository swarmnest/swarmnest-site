---
import { guideBadge, type Guide } from '../lib/guides';
interface Props { g: Guide }
const { g } = Astro.props;
const badge = guideBadge(g);
---
<a class:list={['card', 'guide-card', g.icon && 'guide-card-hex']} href={g.path}>
{g.icon && <span class="guide-row"><picture><source srcset={`/images/guides/icon-${g.icon}.webp`} type="image/webp"><img src={`/images/guides/icon-${g.icon}.png`} alt="" width="72" height="72"></picture><h3>{g.short}</h3></span>}
{!g.icon && <h3>{g.short}</h3>}
<p>{g.blurb}</p>
{badge && <span class="badge">{badge}</span>}
</a>
