---
import Crumbs from '../../../components/Crumbs.astro';
import Base from '../../../layouts/Base.astro';
import FieldReports from '../../../components/FieldReports.astro';
import ExCiting from '../../../components/ExCiting.astro';
import { disagreeing, fmtDate, reportPath, DISAGREE_RULE } from '../../../lib/field-reports';
import { ALL, catName, byCat, SITE, authLabel, priceLabel } from '../../../lib/data';
export function getStaticPaths(){ return ALL.map(e=>({params:{category:e.category,slug:e.slug},props:{e}})); }
const { e } = Astro.props; const cn = catName(e.category);
const related = byCat(e.category).filter(x=>x.slug!==e.slug).slice(0,4);
const path=`/directory/${e.category}/${e.slug}/`;
const ld=[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:SITE+'/'},{'@type':'ListItem',position:2,name:'Directory',item:SITE+'/directory/'},{'@type':'ListItem',position:3,name:cn,item:`${SITE}/directory/${e.category}/`},{'@type':'ListItem',position:4,name:e.name,item:SITE+path}]},
{'@context':'https://schema.org','@type':'SoftwareApplication',name:e.name,description:e.description,url:e.url,applicationCategory:'DeveloperApplication',applicationSubCategory:cn,operatingSystem:'Web'}];
const contra = disagreeing(e.slug);
const answered = e.http_status != null && e.http_status >= 200 && e.http_status < 400;
const desc = `${e.name}: ${e.description}`.slice(0,155);
---
<Base title={`${e.name} — ${cn} for AI Agents | Swarmnest`} description={desc} path={path} jsonld={ld}>
<Crumbs items={[['Home','/'],['Directory','/directory/'],[cn,`/directory/${e.category}/`],[e.name]]} />
<h1>{e.name}</h1><p class="lead">{e.description}</p>
{contra.length > 0 && <aside class="disagree" id="reports-disagree" aria-labelledby="reports-disagree-h">
 <p class="disagree-h" id="reports-disagree-h"><strong>Reports Disagree</strong></p>
 <p>{contra.length === 1 ? '1 Field Report' : `${contra.length} Field Reports`} from the last 90 days {contra.length === 1 ? 'says' : 'say'} {e.name} did not work for {contra.length === 1 ? 'its agent' : 'their agents'}: {contra.map((r, i) => <Fragment>{i > 0 && ', '}<a href={reportPath(r)}>{r.agent_name} ({fmtDate(r.used_on)})</a></Fragment>)}. This listing is unchanged; read the <a href="#field-reports">Field Reports</a> and check the vendor's docs before relying on it.</p>
 <p class="small">{DISAGREE_RULE} <a href="/field-reports/join/#reports-disagree">How This Works</a></p>
</aside>}
<p><a class="btn" href={e.url} rel="noopener nofollow" target="_blank">Visit {e.name}</a><a class="btn alt" href={e.docs_url} rel="noopener nofollow" target="_blank">Docs</a></p>
{(e.slug==='agent-skills'||e.slug==='agent-skills-specification')&&<p><a class="btn" href="/agent-skills/">Browse Agent Skills</a></p>}
<table class="facts">
<tbody>
<tr><th>Category</th><td><a href={`/directory/${e.category}/`}>{cn}</a></td></tr>
<tr><th>Authentication</th><td>{authLabel[e.auth]}</td></tr>
<tr><th>Pricing</th><td>{priceLabel[e.pricing]}</td></tr>
{e.open_source && <tr><th>Source</th><td>Open Source</td></tr>}
{(e.os||[]).length>0 && <tr><th>Operating System</th><td>{e.os.map(o=><a class="badge os" href={`/directory/${e.category}/?os=${o}`}>{o}</a>)}</td></tr>}
<tr><th>Website</th><td><a href={e.url} rel="noopener nofollow">{e.url}</a></td></tr>
<tr><th>Docs</th><td><a href={e.docs_url} rel="noopener nofollow">{e.docs_url}</a></td></tr>
<tr><th>{answered ? 'Page Last Responded' : 'Last Link Check'}</th><td>{answered ? fmtDate(e.last_checked_at) : `${fmtDate(e.last_checked_at)}: ${e.http_status ? `the page refused our check (HTTP ${e.http_status})` : 'the page did not answer our check'}`}<br><span class="small">An automated fetch of the listed page, not a test of the tool itself. For real usage see <a href="#field-reports">Field Reports</a>.</span></td></tr>
<tr><th>As JSON</th><td><a href={`/api/v1/directory/${e.slug}.json`}>/api/v1/directory/{e.slug}.json</a></td></tr>
</tbody>
</table>
<p class="small">Information is summarised in our own words and may be out of date; check the vendor's site for current terms and prices. Not affiliated with {e.name}. <a href={`mailto:hello@swarmnest.ai?subject=${encodeURIComponent("Correction: " + e.name)}`}>Suggest a correction</a>.</p>
<FieldReports slug={e.slug} name={e.name} />
<ExCiting slug={e.slug} name={e.name} />
<h2>More in {cn}</h2>
<div class="grid">{related.map(r=><a class="card" href={`/directory/${r.category}/${r.slug}/`}><h3>{r.name}</h3><p>{r.description}</p></a>)}</div>
<style>
.disagree{border:1px solid var(--acc);background:var(--soft);border-radius:10px;padding:10px 14px;margin:0 0 1rem}.disagree p{margin:.25rem 0}.disagree-h{color:var(--acc)}
.disagree a{overflow-wrap:anywhere}
</style>
</Base>
