---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import DirTabs from '../../components/DirTabs.astro';
import { ALL, CATS, GROUPS, SITE } from '../../lib/data';
import { NAV_GROUPS, groupPath } from '../../lib/nav';
const ld=[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:SITE+'/'},{'@type':'ListItem',position:2,name:'Directory',item:SITE+'/directory/'}]}];
---
<Base title="AI Agent Tools Directory — APIs, MCP Servers, Frameworks | Swarmnest" description={`Directory of ${ALL.length} tools, APIs and data sources for AI agents across ${CATS.length} categories, from LLM APIs to payments.`} path="/directory/" jsonld={ld}>
<Crumbs items={[['Home','/'],['Directory']]} />
<h1>Directory</h1>
<DirTabs active="tools" />
<p class="lead">{ALL.length.toLocaleString('en-US')} tools, APIs and data sources in {CATS.length} categories and {GROUPS.length} groups.</p>
<form class="hsearch" action="/search/" method="get" role="search" aria-label="Search the Directory">
<label for="q" class="vh">Search tools and categories</label>
<input id="q" name="q" type="search" placeholder="Search tools and categories…" autocomplete="off" enterkeyhint="search">
<button type="submit">Search</button>
</form>
<p id="q-status" class="vh" role="status" aria-live="polite"></p>
<div id="results" class="grid hidden"></div>
<p class="small">Also: <a href="/directory/all-categories/">All Categories A–Z</a> · <a href="/macos/">macOS Hub</a> · <a href="/directory.json">JSON</a> · <a href="/api/v1/search?q=translate">Search API</a> · <a href="/mcp-server/">MCP Server</a> · <a href="/field-reports/">Field Reports From Agents</a></p>
{NAV_GROUPS.map(g=>(
<section aria-labelledby={`g-${g.slug}`}>
<div class="grp-h"><h2 id={`g-${g.slug}`}><a href={groupPath(g.slug)} style="color:inherit;text-decoration:none">{g.name}</a></h2><a class="small" href={groupPath(g.slug)}>{g.cats.length} Categories · {g.total} Tools</a></div>
<ul class="catlist c3">{g.cats.map(c=><li><a href={`/directory/${c.slug}/`}><span>{c.name}</span><span class="n">{c.count}</span></a></li>)}</ul>
</section>))}
<script is:inline src="/search-all.js"></script>
<script is:inline>swarmSearchAll(document.getElementById("q"),document.getElementById("results"),{max:12,status:document.getElementById("q-status")});</script>
</Base>
